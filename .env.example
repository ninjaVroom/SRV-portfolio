# PostgreSQL connection string used by the Payload Postgres adapter.
# When running the app on the host against the docker-compose Postgres:
DATABASE_URI=postgres://payload:payload@localhost:5432/srv_portfolio
# When running the app INSIDE docker-compose, use the service hostname instead:
# DATABASE_URI=postgres://payload:payload@postgres:5432/srv_portfolio

# Secret used to sign Payload tokens. Generate a long random value for production.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public URL of the site (used for absolute links / CORS).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Credentials used by the seed script to create the first admin user.
SEED_ADMIN_EMAIL=admin@samuelrolandvroom.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# ---- Contact form email (optional) ----
# Where contact-form submissions are emailed. Falls back to Site Settings → email.
CONTACT_TO=sr.vroom@outlook.com
# SMTP is only used when SMTP_HOST is set. Without it, submissions are still saved
# (Messages collection) and the email is logged to the server console.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your-smtp-password
# SMTP_FROM=portfolio@samuelrolandvroom.com
# SMTP_FROM_NAME=Samuel Roland Vroom
